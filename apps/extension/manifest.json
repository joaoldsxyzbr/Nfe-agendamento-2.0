{
  "manifest_version": 3,
  "name": "NFe Agendamento",
  "version": "0.2.11",
  "description": "Consulta NF-e pelo Portal Nacional e devolve o XML ao site NFe Agendamento.",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://nfeagendamento.joaolds.xyz.br/*",
    "https://www.nfe.fazenda.gov.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nfeagendamento.joaolds.xyz.br/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.nfe.fazenda.gov.br/portal/*"
      ],
      "js": [
        "portal-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "NFe Agendamento",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
