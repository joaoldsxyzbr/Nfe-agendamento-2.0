{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nfe-agendamento-2",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-15",
  "build": {
    "command": "npm run build:web"
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS"
  },
  "exports": {
    "FiscalCoordinator": {
      "type": "durable-object",
      "state": "deleted"
    }
  }
}
